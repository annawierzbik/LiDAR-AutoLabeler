# Settings of the deployment (docker-compose.yml). Copy to .env and fill in every value marked
# REQUIRED: docker compose refuses to start while one is missing. There are no default secrets.
# Make secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use URL-safe characters (letters, digits, - and _): the passwords become parts of URLs.

# --- secrets (REQUIRED) -------------------------------------------------------------------
# PostgreSQL password of the user "lal" (also in LAL_DATABASE_URL of the app containers)
LAL_DB_PASSWORD=
# Redis password (the Celery broker)
LAL_REDIS_PASSWORD=
# signing key of the login tokens: at least 32 characters, the same for every API replica;
# changing it logs everyone out (docs/adr/0016)
LAL_JWT_SECRET=
# MinIO root user and password; the app uses them as its S3 access key and secret (docs/adr/0020)
LAL_MINIO_USER=
LAL_MINIO_PASSWORD=

# --- gateway (nginx) ----------------------------------------------------------------------
# published ports
LAL_HTTPS_PORT=443
LAL_HTTP_PORT=80
# folder with tls.crt and tls.key (python scripts/make_dev_cert.py writes a self-signed pair for
# localhost into deploy/nginx/certs)
LAL_TLS_DIR=./deploy/nginx/certs
# HSTS max-age in seconds; set 0 on https://localhost, or browsers insist on HTTPS for every
# localhost port for that long
LAL_HSTS_MAX_AGE=31536000
# login attempts per client IP (nginx limit_req) and how many may come at once above that rate
LAL_LOGIN_RATE=10r/m
LAL_LOGIN_BURST=5

# --- application --------------------------------------------------------------------------
# true only with the GPU worker (docker compose --profile gpu ...); false refuses assisted openings
LAL_ASSISTED_MODE=false
# upload limits in bytes: archive (also nginx's client_max_body_size for the upload) and unpacked
LAL_UPLOAD_MAX_BYTES=2147483648
LAL_UPLOAD_MAX_UNPACKED_BYTES=8589934592
# export zips are kept this long; the scheduler deletes expired ones this often
LAL_EXPORT_TTL_HOURS=24
LAL_EXPORT_PRUNE_MINUTES=15
# login lifetimes (docs/adr/0016)
LAL_ACCESS_TOKEN_MINUTES=15
LAL_REFRESH_TOKEN_DAYS=7
# bucket of the blob areas uploads/, cache/, exports/ (created by the migrate service)
LAL_S3_BUCKET=lal

# --- host folders -------------------------------------------------------------------------
# folders an admin may register (mounted read-only at /data; empty when not set)
LAL_DATA_DIR=./deploy/empty-data
# folder holding pointpillar_7728.pth for the GPU worker (mounted read-only, not in the image)
LAL_MODELS_DIR=./checkpoints

# tag of the images built by docker compose build
LAL_IMAGE_TAG=local
